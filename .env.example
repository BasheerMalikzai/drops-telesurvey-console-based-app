# KoBoToolbox connection. Keep this file private (setup.sh sets it to chmod 600).
# Token: KoBo > Account Settings > Security > API Key
KOBO_TOKEN=
# Form UID: the part after /forms/ in the form's URL, e.g. aBcD3fGh1JkLmNoP
KOBO_ASSET_UID=
# https://kf.kobotoolbox.org (global) or https://eu.kobotoolbox.org (EU)
KOBO_URL=https://kf.kobotoolbox.org
# Name of the media file the XLSForm uses in select_one_from_file
KOBO_MEDIA_FILENAME=assignments.csv
# 1 = redeploy the form after each upload so devices pick up the new list
KOBO_REDEPLOY=1
# Optional, only for `verify`: lets it read the form list exactly as KoboCollect
# does, if your server doesn't accept the API token there
KOBO_USERNAME=
KOBO_PASSWORD=


# ---- Email reports (recipients are in config.json > report.recipients)
# Gmail: smtp.gmail.com, port 587, starttls, and an App Password (not your normal password)
# Microsoft 365: smtp.office365.com, port 587, starttls
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587) | ssl (port 465) | none (port 25, internal relays only)
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
# sender address shown in the email (defaults to SMTP_USER)
SMTP_FROM=

# ---- Database
# postgres (recommended) or sqlite (single file, fine for testing)
DB_ENGINE=postgres
PGHOST=localhost
PGPORT=5432
PGDATABASE=telesurvey
PGUSER=
PGPASSWORD=
# disable | prefer | require (use require for cloud databases)
PGSSLMODE=prefer
# optional: keep the tables in their own schema inside a shared database
PG_SCHEMA=
# optional: one URL instead of the settings above, e.g. postgresql://user:pass@host:5432/db
DATABASE_URL=

# ---- Server
# Your time zone, so "today" is your local day on UTC servers (e.g. Africa/Accra)
TZ=
# SQLite only: 0 on network storage such as PythonAnywhere; 1 (default) on a normal disk
SQLITE_WAL=1
